<?xml version="1.0" encoding="UTF-8"?>
<!--
  Files installed alongside the service (CepAgent.exe is installed by
  ServiceComponent in Package.wxs). The agent is published self-contained and
  single-file (IncludeNativeLibrariesForSelfExtract), so the publish output is
  just the two executables plus appsettings.json — everything else is bundled
  into the exes. Component GUIDs are auto-generated by WiX v4 from the target
  path (stable across builds).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Id="CepAgentUpdaterExe" Source="$(PublishDir)\CepAgent.Updater.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Id="AppSettingsJson" Source="$(PublishDir)\appsettings.json" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
