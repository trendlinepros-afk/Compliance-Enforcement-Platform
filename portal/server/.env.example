# Portal server environment. Copy to .env for local development.

# PostgreSQL connection string. Railway injects this automatically from the
# Postgres plugin; set it manually for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cep

# Secret used to sign session JWTs (httpOnly cookies). Use a long random value.
JWT_SECRET=change-me-to-a-long-random-string

# Seed admin user created on first boot (idempotent). If the user already
# exists it is left untouched.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# Public URL of the portal, used to build the agent install one-liner and the
# MSI proxy URLs. On Railway set this to your service's public domain.
PUBLIC_URL=http://localhost:8080

# Port the server listens on (Railway sets PORT automatically).
PORT=8080
