<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Tests run on the CI host (linux or windows); the parser/math code under
         test is platform-neutral. Suppress the win-only platform warnings. -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the parser/engine source directly (no win-only runtime needed for these units). -->
    <Compile Include="..\..\src\CepAgent\Parsers\PregFile.cs" Link="Parsers\PregFile.cs" />
    <Compile Include="..\..\src\CepAgent\Parsers\PregRecord.cs" Link="Parsers\PregRecord.cs" />
    <Compile Include="..\..\src\CepAgent\Parsers\GptIni.cs" Link="Parsers\GptIni.cs" />
    <Compile Include="..\..\src\CepAgent\Parsers\SecEditInf.cs" Link="Parsers\SecEditInf.cs" />
    <Compile Include="..\..\src\CepAgent\Parsers\AuditCsv.cs" Link="Parsers\AuditCsv.cs" />
    <Compile Include="..\..\src\CepAgent\Engines\ValueCompare.cs" Link="Engines\ValueCompare.cs" />
    <Compile Include="..\..\src\CepAgent\Engines\UpdateSchedule.cs" Link="Engines\UpdateSchedule.cs" />
  </ItemGroup>

</Project>
